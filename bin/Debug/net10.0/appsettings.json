{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=NetSentinelDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "JwtSettings": {
    "Issuer": "NetSentinel.API",
    "Audience": "NetSentinel.Mobile",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },

  "FirebaseSettings": {
    "Enabled": false,
    "CredentialsPath": "firebase-service-account.json"
  },

  "SnortSettings": {
    "Enabled": true,
    "AlertFilePath": "alert_json.txt",
    "PollIntervalMilliseconds": 500
  },

  "DeviceDiscovery": {
    "AllowedSubnet": "",
    "PingTimeoutMs": 600,
    "MaxConcurrency": 64
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}